{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hakoniwa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
